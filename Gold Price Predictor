        const now = new Date();
        document.getElementById('liveTimestamp').textContent = now.toLocaleTimeString('en-IN', { hour12: false }) + ' IST | Siliguri WB';
      }
      setInterval(updateClock, 1000);
      updateClock();

      setInterval(() => {
        const fluctuation = (Math.random() - 0.48) * 45;
        const currentMCX = getAdjustedPrice(state.basePrice24K);
        const newMCX = Math.round(currentMCX + fluctuation);
        const delta = newMCX - currentMCX;
        
        const deltaEl = document.getElementById('tickerDelta');
        if (delta >= 0) {
          deltaEl.textContent = `+₹${delta} (+${((delta/currentMCX)*100).toFixed(2)}%)`;
          deltaEl.className = "text-emerald-400 text-[10px] font-semibold";
        } else {
          deltaEl.textContent = `-₹${Math.abs(delta)} (-${((Math.abs(delta)/currentMCX)*100).toFixed(2)}%)`;
          deltaEl.className = "text-rose-400 text-[10px] font-semibold";
        }
      }, 4000);
    }

