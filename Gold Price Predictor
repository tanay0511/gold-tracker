    function updateChartData() {
      if (!chartInstance) return;

      const today = state.todayDate;
      let pastDaysLimit = 180;

      switch (state.timeRange) {
        case '7D': pastDaysLimit = 7; break;
        case '1M': pastDaysLimit = 30; break;
        case '3M': pastDaysLimit = 90; break;
        case '6M': pastDaysLimit = 180; break;
        case '1Y': pastDaysLimit = 365; break;
        case '5Y': pastDaysLimit = 365 * 5; break;
      }

      const pastThreshold = new Date(today);
      pastThreshold.setDate(today.getDate() - pastDaysLimit);

      const futureThreshold = new Date(today);
      futureThreshold.setDate(today.getDate() + state.forecastDays);

      const filtered = fullDataset.filter(item => {
        return item.date >= pastThreshold && item.date <= futureThreshold;
      });

      const stride = filtered.length > 250 ? Math.ceil(filtered.length / 140) : 1;
      const sampled = filtered.filter((_, idx) => idx % stride === 0 || idx === filtered.length - 1);

      const labels = [];
      const actual24KData = [];
      const forecast24KData = [];
      const track22KData = [];
      const upperBandData = [];
      const lowerBandData = [];

      sampled.forEach(item => {
        labels.push(formatDateStr(item.date));
        
        const adj24K = getAdjustedPrice(item.price24K);
        const adj22K = getAdjustedPrice(item.price22K);
        const adjUpper = getAdjustedPrice(item.confidenceUpper);
        const adjLower = getAdjustedPrice(item.confidenceLower);

        if (!item.isForecast) {
          actual24KData.push(adj24K);
          if (item.date.toDateString() === today.toDateString()) {
            forecast24KData.push(adj24K);
            upperBandData.push(state.showBand ? adjUpper : null);
            lowerBandData.push(state.showBand ? adjLower : null);
          } else {
            forecast24KData.push(null);
            upperBandData.push(null);
            lowerBandData.push(null);
          }
          track22KData.push(state.show22K ? adj22K : null);
        } else {
          actual24KData.push(null);
          forecast24KData.push(adj24K);
          upperBandData.push(state.showBand ? adjUpper : null);
          lowerBandData.push(state.showBand ? adjLower : null);
          track22KData.push(state.show22K ? adj22K : null);
        }
      });

      chartInstance.data.labels = labels;
      chartInstance.data.datasets[0].data = upperBandData;
      chartInstance.data.datasets[1].data = lowerBandData;
      chartInstance.data.datasets[2].data = actual24KData;
      chartInstance.data.datasets[3].data = forecast24KData;
      chartInstance.data.datasets[4].data = track22KData;

      chartInstance.data.datasets[0].hidden = !state.showBand;
      chartInstance.data.datasets[1].hidden = !state.showBand;
      chartInstance.data.datasets[4].hidden = !state.show22K;

      chartInstance.update();
    }

    function updateStatCards() {
      const todaySpot = fullDataset.find(d => d.date.toDateString() === state.todayDate.toDateString()) || fullDataset[0];
      const targetSpot = fullDataset.find(d => {
        const targetDay = new Date(state.todayDate);
        targetDay.setDate(targetDay.getDate() + 30);
        return d.date.toDateString() === targetDay.toDateString();
      }) || fullDataset[fullDataset.length - 1];

      const p24K = getAdjustedPrice(todaySpot.price24K);
      const p22K = getAdjustedPrice(todaySpot.price22K);
      const p18K = getAdjustedPrice(todaySpot.price18K);
      const targetP = getAdjustedPrice(targetSpot.price24K);

      const unitText = getUnitName().replace('₹ ', '');

      document.getElementById('unitLabel1').textContent = unitText;
      document.getElementById('unitLabel2').textContent = unitText;
      document.getElementById('unitLabel3').textContent = unitText;
      document.getElementById('unitLabel4').textContent = unitText;

      document.getElementById('cardPrice24K').textContent = formatINR(p24K);
      document.getElementById('cardPrice22K').textContent = formatINR(p22K);
      document.getElementById('cardPrice18K').textContent = formatINR(p18K);
      document.getElementById('cardTargetPrice').textContent = formatINR(targetP);

      // Per-gram breakdown
      const gramMultiplier = UNIT_MULTIPLIERS[state.currentUnit] * 10;
      document.getElementById('cardPerGram24K').textContent = `${formatINR(p24K / gramMultiplier)} / g`;
      document.getElementById('cardPerGram22K').textContent = `${formatINR(p22K / gramMultiplier)} / g`;
      document.getElementById('cardPerGram18K').textContent = `${formatINR(p18K / gramMultiplier)} / g`;

      // 3% GST computation
      document.getElementById('cardGst24K').textContent = formatINR(p24K * 1.03);
      document.getElementById('cardGst22K').textContent = formatINR(p22K * 1.03);
      document.getElementById('cardGst18K').textContent = formatINR(p18K * 1.03);
      document.getElementById('cardTargetGst').textContent = formatINR(targetP * 1.03);

      // Ticker updates
      document.getElementById('tickerMCX').textContent = formatINR(getAdjustedPrice(todaySpot.price24K));
      document.querySelectorAll('.unit-text').forEach(el => el.textContent = unitText);
    }

    function evaluateCustomDate(selectedDateObj) {
      if (!selectedDateObj || isNaN(selectedDateObj.getTime())) {
        showToast('Please select a valid evaluation date.');
        return;
      }

      const today = state.todayDate;
      const isFuture = selectedDateObj > today;
      const isToday = selectedDateObj.toDateString() === today.toDateString();

      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      document.getElementById('evalDateFormatted').textContent = selectedDateObj.toLocaleDateString('en-IN', options);

      const targetIso = toISODate(selectedDateObj);
      let record = fullDataset.find(d => d.dateStr === targetIso);

      let price24K = 0;
      let confidence = 96;

      if (record) {
        price24K = record.price24K;
        confidence = record.confidencePct;
      } else {
        const diffDays = Math.round((selectedDateObj - today) / (1000 * 60 * 60 * 24));
        if (diffDays > 0) {
          const compoundGrowth = Math.pow(1 + 0.092 / 365, diffDays);
          price24K = Math.round(state.basePrice24K * compoundGrowth);
          confidence = Math.max(55, Math.round(96 - (diffDays * 0.06)));
        } else {
          const compoundDecline = Math.pow(1 + 0.085 / 365, diffDays);
          price24K = Math.round(state.basePrice24K * compoundDecline);
          confidence = 98;
        }
      }

      const adj24K = getAdjustedPrice(price24K);
      const adj22K = Math.round(adj24K * (140650 / 153440));
      const gramDivisor = UNIT_MULTIPLIERS[state.currentUnit] * 10;
      const perGram24K = Math.round(adj24K / gramDivisor);
      const perGram22K = Math.round(adj22K / gramDivisor);
      const gstAmt = Math.round(adj24K * 0.03);
      const finalWithGst = Math.round(adj24K + gstAmt);

      const badgeEl = document.getElementById('dateTypeBadge');
      if (isToday) {
        badgeEl.textContent = 'MCX Spot Benchmark';
        badgeEl.className = 'text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
      } else if (isFuture) {
        badgeEl.textContent = 'AI Predictive Projection';
        badgeEl.className = 'text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/40';
      } else {
        badgeEl.textContent = 'Historical Archive Record';
        badgeEl.className = 'text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-slate-700/50 text-slate-300 border border-slate-600';
      }

      document.getElementById('evalConfidenceText').textContent = confidence + '%';
      document.getElementById('evalConfidenceBar').style.width = confidence + '%';

      document.getElementById('evalBase24K').textContent = formatINR(adj24K);
      document.getElementById('evalPerGram24K').textContent = `${formatINR(perGram24K)} / g`;

      document.getElementById('evalBase22K').textContent = formatINR(adj22K);
      document.getElementById('evalPerGram22K').textContent = `${formatINR(perGram22K)} / g`;

      document.getElementById('evalGST').textContent = formatINR(gstAmt);
      document.getElementById('evalFinalTotal').textContent = formatINR(finalWithGst);

      // Making charges calculation (~10% avg on 22K)
      const makingChargeVal = Math.round(adj22K * 0.10);
      const makingWithGst = Math.round((adj22K + makingChargeVal) * 1.03);
      const makingEl = document.getElementById('makingChargeAmount');
      makingEl.textContent = `Est. Making: +${formatINR(makingChargeVal)} (Total 22K with GST: ${formatINR(makingWithGst)})`;
      makingEl.classList.toggle('hidden', !state.includeMakingCharges);

      const spread = isFuture ? Math.round(adj24K * ((100 - confidence) * 0.002)) : 100;
      document.getElementById('evalRangeInfo').textContent = `Forecast Band: ${formatINR(adj24K - spread)} – ${formatINR(adj24K + spread)}`;

      const todaySpot = getAdjustedPrice(state.basePrice24K);
      const deltaFromToday = adj24K - todaySpot;
      const pctDelta = ((deltaFromToday / todaySpot) * 100).toFixed(2);
      const deltaSign = deltaFromToday >= 0 ? '+' : '';
      const deltaColorClass = deltaFromToday >= 0 ? 'text-emerald-400' : 'text-rose-400';

      const deltaEl = document.getElementById('evalDeltaFromToday');
      deltaEl.className = `${deltaColorClass} font-semibold`;
      deltaEl.textContent = `${deltaSign}${formatINR(deltaFromToday)} from Today (${deltaSign}${pctDelta}%)`;
    }

    function renderTable() {
      const tableBody = document.getElementById('tableBody');
      const searchQuery = state.table.searchQuery.toLowerCase().trim();
      const filterType = state.table.filterType;

      let records = fullDataset.filter(item => {
        if (filterType === 'actual' && item.isForecast) return false;
        if (filterType === 'forecast' && !item.isForecast) return false;

        if (searchQuery) {
          const readable = formatDateStr(item.date).toLowerCase();
          const iso = item.dateStr.toLowerCase();
          if (!readable.includes(searchQuery) && !iso.includes(searchQuery)) {
            return false;
          }
        }
        return true;
      });

      records.sort((a, b) => {
        return state.table.sortAsc ? (a.date - b.date) : (b.date - a.date);
      });

      const totalRecords = records.length;
      const totalPages = Math.ceil(totalRecords / state.table.pageSize) || 1;

      if (state.table.currentPage > totalPages) state.table.currentPage = totalPages;
      if (state.table.currentPage < 1) state.table.currentPage = 1;

      const startIndex = (state.table.currentPage - 1) * state.table.pageSize;
      const paginatedItems = records.slice(startIndex, startIndex + state.table.pageSize);

      if (paginatedItems.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="8" class="text-center py-8 text-slate-500 font-mono">
              <i class="fa-solid fa-folder-open text-2xl mb-2 block"></i>
              No matching bullion records found.
            </td>
          </tr>
        `;
      } else {
        tableBody.innerHTML = paginatedItems.map(item => {
          const adj24 = getAdjustedPrice(item.price24K);
          const adj22 = getAdjustedPrice(item.price22K);
          const adj18 = getAdjustedPrice(item.price18K);
          const withGst = Math.round(adj24 * 1.03);
          const isUp = item.change >= 0;
          const changeColor = isUp ? 'text-emerald-400' : 'text-rose-400';
          const changeIcon = isUp ? '▲' : '▼';

          const typeBadge = item.isForecast 
            ? `<span class="px-2 py-0.5 rounded text-[10px] bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">Forecast</span>`
            : `<span class="px-2 py-0.5 rounded text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Official MCX</span>`;

          return `
            <tr class="hover:bg-dark-850/60 transition cursor-default">
              <td class="py-3 px-4 text-white font-medium whitespace-nowrap">
                ${formatDateStr(item.date)}
              </td>
              <td class="py-3 px-4 whitespace-nowrap">
                ${typeBadge}
              </td>
              <td class="py-3 px-4 text-right font-bold text-gold-300">
                ${formatINR(adj24)}
              </td>
              <td class="py-3 px-4 text-right text-amber-200">
                ${formatINR(adj22)}
              </td>
              <td class="py-3 px-4 text-right text-slate-300">
                ${formatINR(adj18)}
              </td>
              <td class="py-3 px-4 text-right font-bold text-emerald-400">
                ${formatINR(withGst)}
              </td>
              <td class="py-3 px-4 text-right ${changeColor} whitespace-nowrap">
                ${changeIcon} ${formatINR(Math.abs(getAdjustedPrice(item.change)))} (${item.changePct.toFixed(2)}%)
              </td>
              <td class="py-3 px-4 text-center">
                <span class="text-xs font-semibold ${item.confidencePct > 85 ? 'text-emerald-400' : 'text-amber-400'}">${item.confidencePct}%</span>
              </td>
            </tr>
          `;
        }).join('');
      }

      const startDisplay = totalRecords > 0 ? startIndex + 1 : 0;
      const endDisplay = Math.min(startIndex + state.table.pageSize, totalRecords);
      document.getElementById('tableRecordCount').textContent = `Showing ${startDisplay} - ${endDisplay} of ${totalRecords} entries`;
      document.getElementById('pageIndicator').textContent = `Page ${state.table.currentPage} of ${totalPages}`;
      document.getElementById('prevPageBtn').disabled = state.table.currentPage <= 1;
      document.getElementById('nextPageBtn').disabled = state.table.currentPage >= totalPages;
    }

    // CSV Export
    function exportToCSV() {
      const unitHeader = getUnitName();
      const csvRows = [];
      csvRows.push(['Date', 'Type', `24K Base (${unitHeader})`, `22K Base (${unitHeader})`, `18K Base (${unitHeader})`, 'With 3% GST', 'Change (INR)', 'Change (%)', 'Confidence (%)']);

      fullDataset.forEach(row => {
        csvRows.push([
          row.dateStr,
          row.isForecast ? 'Forecast' : 'Historical',
          Math.round(getAdjustedPrice(row.price24K)),
          Math.round(getAdjustedPrice(row.price22K)),
          Math.round(getAdjustedPrice(row.price18K)),
          Math.round(getAdjustedPrice(row.price24K) * 1.03),
          Math.round(getAdjustedPrice(row.change)),
          row.changePct.toFixed(2),
          row.confidencePct
        ]);
      });

      const csvContent = "data:text/csv;charset=utf-8," + csvRows.map(e => e.join(",")).join("\n");
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `Gold_Rates_India_Sept2026_${toISODate(state.todayDate)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("Calibrated CSV ledger downloaded successfully.");
    }

    let toastTimer;
    function showToast(message, isSuccess = true) {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMessage');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.textContent = message;
      toastIcon.className = isSuccess 
        ? "fa-solid fa-circle-check text-gold-400 text-base" 
        : "fa-solid fa-circle-exclamation text-amber-400 text-base";

      toast.classList.remove('translate-y-24', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3000);
    }

