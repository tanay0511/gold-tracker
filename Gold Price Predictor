      // Pre-select September 16, 2026 to verify quoted rate
      const defaultDate = new Date('2026-09-16T00:00:00');
      document.getElementById('customDateInput').value = toISODate(defaultDate);

      initChart();
      updateStatCards();
      updateChartData();
      evaluateCustomDate(defaultDate);
      renderTable();
      setupEventListeners();
      startLiveTickerSimulation();
    });
  </script>
